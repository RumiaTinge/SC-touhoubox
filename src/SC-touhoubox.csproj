<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SC-touhoubox</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Sc2Toolbox</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="Sc2Toolbox\App.xaml" />
    <ApplicationDefinition Include="Sc2Toolbox\App.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="app.xaml" />
    <Page Remove="Sc2Toolbox\AlertWindow.xaml" />
    <Page Remove="Sc2Toolbox\MainWindow.xaml" />
    <Page Remove="Sc2Toolbox\MatchWindow.xaml" />
    <Page Remove="Sc2Toolbox\OverlayWindow.xaml" />
    <Page Remove="theme.xaml" />
    <Page Include="Sc2Toolbox\AlertWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="alertwindow.xaml" />
    <Page Include="Sc2Toolbox\MainWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="mainwindow.xaml" />
    <Page Include="Sc2Toolbox\MatchWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="matchwindow.xaml" />
    <Page Include="Sc2Toolbox\OverlayWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="overlaywindow.xaml" />
    <Page Include="theme.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="theme.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="app.ico" LogicalName="app.ico" />
    <Resource Include="brand.png" LogicalName="brand.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Nmpq" Version="1.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- 图片资源随包输出：克隆仓库后直接 dotnet build 就能跑，不用另外下资源 -->
    <Content Include="..\art\**\*" Link="art\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>