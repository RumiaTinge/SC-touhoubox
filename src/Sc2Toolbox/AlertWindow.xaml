<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Sc2Toolbox.AlertWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="开局警报" WindowStyle="None" Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" WindowStartupLocation="Manual" Background="#FF12060A" FontFamily="Microsoft YaHei UI" xmlns:sc2toolbox="clr-namespace:Sc2Toolbox;assembly=SC-touhoubox" MouseDown="Win_MouseDown">
  <Grid>
    <Panel.Background>
      <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.34" RadiusX="0.9" RadiusY="0.85">
        <GradientStop Color="#FF7C1220" Offset="0" />
        <GradientStop Color="#FF3D0812" Offset="0.5" />
        <GradientStop Color="#FF0C0306" Offset="1" />
      </RadialGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Image Name="Img" Grid.Row="0" Stretch="Uniform" Margin="48,36,48,10" HorizontalAlignment="Center" VerticalAlignment="Center" />

    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="40,10,40,0">
      <Border Width="140" Height="3" CornerRadius="2" HorizontalAlignment="Center" Margin="0,0,0,24">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FF6B6B" Offset="0" />
            <GradientStop Color="#FFFF5A5A" Offset="0.5" />
            <GradientStop Color="#00FF6B6B" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
          <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.9" Color="#FFFF3B3B" />
        </Border.Effect>
      </Border>
      <TextBlock Name="TxtTitle" Text="开局了！" Foreground="#FFFFF3F3" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap">
        <UIElement.Effect>
          <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.85" Color="#FFFF3B3B" />
        </UIElement.Effect>
        <FrameworkElement.Triggers>
          <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.75" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </FrameworkElement.Triggers>
      </TextBlock>
    </StackPanel>

    <TextBlock Name="TxtBody" Grid.Row="2" Text="" Foreground="#FFFFCFCF" FontSize="24" HorizontalAlignment="Center" Margin="40,20,40,0" TextAlignment="Center" TextWrapping="Wrap" />

    <Border Grid.Row="3" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="99" Background="#14FFFFFF" BorderBrush="#2EFF9A9A" BorderThickness="1" Padding="18,9" Margin="40,38,40,0">
      <TextBlock Name="TxtHint" Text="（点一下这里 或 按 Ctrl+Alt+Shift+A 关闭）" Foreground="#B3FFDCDC" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>
