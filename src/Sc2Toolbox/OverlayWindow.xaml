<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Sc2Toolbox.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="房间悬浮窗" Width="330" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False" ResizeMode="NoResize" WindowStartupLocation="Manual" FontFamily="Microsoft YaHei UI" xmlns:sc2toolbox="clr-namespace:Sc2Toolbox;assembly=SC-touhoubox">
  <Border Name="Root" CornerRadius="16" BorderBrush="#1FFFFFFF" BorderThickness="1" Margin="10">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.65,1">
        <GradientStop Color="#F2161E2B" Offset="0" />
        <GradientStop Color="#F20C1119" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <UIElement.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.62" Direction="270" />
    </UIElement.Effect>
    <StackPanel>
      <Border Name="Head" Background="#00FFFFFF" Padding="13,10,9,10" MouseLeftButtonDown="Head_MouseLeftButtonDown">
        <FrameworkElement.ContextMenu>
          <ContextMenu>
            <MenuItem Header="打开设置面板" Click="Menu_Settings" />
            <MenuItem Name="MiClickThrough" Header="鼠标穿透（点不到）" IsCheckable="True" Click="Menu_ClickThrough" />
            <MenuItem Name="MiChat" Header="显示聊天记录" IsCheckable="True" Click="Menu_Chat" />
            <MenuItem Name="MiChatCmds" Header="聊天里也显示指令行（-vk 之类）" IsCheckable="True" Click="Menu_ChatCmds" />
            <Separator />
            <MenuItem Header="关闭悬浮窗" Click="Menu_Hide" />
          </ContextMenu>
        </FrameworkElement.ContextMenu>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" VerticalAlignment="Center">
            <Ellipse Width="17" Height="17" Fill="#17FFFFFF" />
            <Border Name="Dot" Width="8" Height="8" CornerRadius="4" Background="#FF6B7280" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center" Background="#00FFFFFF" MouseLeftButtonDown="RoomHead_Click" ToolTip="点一下折叠 / 展开房间列表">
            <TextBlock Name="RoomCaret" Text="▾" Foreground="{StaticResource B.Muted}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
            <TextBlock Name="TxtTitle" Text="房间" Foreground="{StaticResource B.Text}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border CornerRadius="99" Background="#14FFFFFF" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock Name="TxtCount" Text="—" Foreground="{StaticResource B.Muted}" FontSize="11.5" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Name="BtnTest" Content="试响" Style="{StaticResource BtnGhost}" FontSize="11.5" Padding="7,4" Click="BtnTest_Click" />
            <Button Name="BtnCfg" Content="设置" Style="{StaticResource BtnGhost}" FontSize="11.5" Padding="7,4" Click="BtnCfg_Click" />
            <Button Name="BtnHide" Content="✕" Style="{StaticResource BtnGhost}" FontSize="13" Padding="7,2" Click="BtnHide_Click" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Height="1" Background="#14FFFFFF" />
      <StackPanel Name="RoomBody">
      <ItemsControl Name="List" Margin="10,8,10,4">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border CornerRadius="8" ToolTip="{Binding Tip}">
              <Border.Style>
                <Style TargetType="{x:Type Border}">
                  <Setter Property="Background" Value="#00FFFFFF" />
                  <Style.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Property="Background" Value="#0DFFFFFF" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid Height="28" Margin="4,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="19" Height="19" CornerRadius="6" Background="#14FFFFFF" VerticalAlignment="Center">
                  <TextBlock FontSize="10.5" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding No}" />
                </Border>
                <Border Grid.Column="1" Width="21" Height="21" CornerRadius="6" Background="#14FFFFFF" Margin="6,0,0,0" VerticalAlignment="Center" ClipToBounds="True" HorizontalAlignment="Left">
                  <Image Stretch="UniformToFill" Source="{Binding Avatar}" />
                </Border>
                <TextBlock Grid.Column="2" Margin="8,0,6,0" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding Name}" Foreground="{Binding Color}" />
                <TextBlock Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource B.Dim}" Text="{Binding Mmr}" />
                <Border Grid.Column="4" CornerRadius="99" Background="{StaticResource B.AccentSoft}" Padding="7,2" VerticalAlignment="Center" Margin="6,0,0,0">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Value="" Binding="{Binding Tag}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <TextBlock FontSize="10.5" Foreground="{StaticResource B.Accent2}" Text="{Binding Tag}" />
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
      <StackPanel Name="ChatPanel" Margin="10,6,10,2" Visibility="Collapsed">
        <Grid Name="ChatHead" Margin="3,0,3,4" Background="#00FFFFFF" MouseLeftButtonDown="ChatHead_Click" ToolTip="点一下折叠 / 展开聊天记录">
          <StackPanel Orientation="Horizontal">
            <TextBlock Name="ChatCaret" Text="▾" Foreground="{StaticResource B.Muted}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
            <TextBlock Text="聊天记录" Foreground="{StaticResource B.Text}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Name="TxtChatHint" Text="" HorizontalAlignment="Right" Foreground="{StaticResource B.Dim}" FontSize="10.5" VerticalAlignment="Center" />
        </Grid>
        <ScrollViewer Name="ChatBody" MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Name="ChatList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ContentControl Content="{Binding Visual}" Margin="3,1" HorizontalAlignment="Left" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
      <Border Height="1" Background="#14FFFFFF" Margin="0,4,0,0" />
      <StackPanel Margin="13,9,13,12">
        <TextBlock Name="TxtMe" Text="" Foreground="{StaticResource B.Accent2}" FontSize="11.5" TextWrapping="Wrap" Visibility="Collapsed" />
        <TextBlock Name="TxtKeep" Text="保活：等待中" Foreground="#FF9AA7B4" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,0" />
        <TextBlock Name="TxtData" Text="房间接口：连接中…" Foreground="{StaticResource B.Dim}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
        <TextBlock Name="TxtNote" Text="" Foreground="{StaticResource B.Warn}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
