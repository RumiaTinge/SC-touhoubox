<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Sc2Toolbox.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SC-touhoubox · 东方月灵传助手" Height="680" Width="1000" MinHeight="560" MinWidth="880" Background="{StaticResource B.Window}" Foreground="{StaticResource B.Text}" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" WindowStyle="None" ResizeMode="CanResize" Icon="/app.ico" xmlns:sc2toolbox="clr-namespace:Sc2Toolbox;assembly=SC-touhoubox">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- 卡片标题：点一下折叠 / 展开这张卡片。放在窗口资源里才能挂事件处理函数。 -->
    <Style x:Key="CardHead" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource H2}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="ToolTip" Value="点一下折叠 / 展开这张卡片" />
      <EventSetter Event="MouseLeftButtonDown" Handler="CardHead_Click" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== 自绘标题栏 ===== -->
    <Grid Grid.Row="0" Background="#0AFFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <FrameworkElement.ContextMenu>
        <ContextMenu>
          <MenuItem Header="最小化" Click="BtnMin_Click" />
          <MenuItem Header="最大化 / 还原" Click="BtnMax_Click" />
          <Separator />
          <MenuItem Header="关闭" Click="BtnClose_Click" />
        </ContextMenu>
      </FrameworkElement.ContextMenu>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- 标题栏左侧留空：应用标识只在左侧栏出现一次，避免重复 -->
      <Border Grid.Column="0" />
      <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1" Background="{StaticResource B.LineSoft}" IsHitTestVisible="False" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,5,0" VerticalAlignment="Center">
        <Button Name="BtnMin" Style="{StaticResource WinBtn}" Click="BtnMin_Click" ToolTip="最小化">
          <Rectangle Width="11" Height="1.4" RadiusX="0.7" RadiusY="0.7" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
        </Button>
        <Button Name="BtnMax" Style="{StaticResource WinBtn}" Click="BtnMax_Click" ToolTip="最大化 / 还原">
          <Grid>
            <Path Name="GlyphMax" Data="M0.6,0.6 H10.6 V10.6 H0.6 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.1" />
            <Path Name="GlyphRestore" Data="M3.6,0.6 H10.6 V7.6 M0.6,3.6 H7.6 V10.6 H0.6 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.1" Visibility="Collapsed" />
          </Grid>
        </Button>
        <Button Name="BtnClose" Style="{StaticResource WinBtnClose}" Click="BtnClose_Click" ToolTip="关闭">
          <Path Data="M0.6,0.6 L10.6,10.6 M10.6,0.6 L0.6,10.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.1" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ===== 主体 ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource B.Sidebar}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,18,18,22">
            <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource B.Card2}" BorderBrush="{StaticResource B.LineSoft}" BorderThickness="1" ClipToBounds="True">
              <Image Source="/brand.png" Stretch="Uniform" Margin="1" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="SC-touhoubox" Foreground="{StaticResource B.Text}" FontSize="14.5" FontWeight="SemiBold" />
              <TextBlock Text="东方月灵传助手 · v1.1" Foreground="{StaticResource B.Dim}" FontSize="10.5" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="10,0">
            <RadioButton Name="Nav1" Style="{StaticResource Nav}" GroupName="nav" IsChecked="True" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" Data="M1.5,2.5 H14.5 V11.5 H1.5 Z M6,14.5 H10 M8,11.5 V14.5" />
                <TextBlock Text="房间悬浮窗" Margin="11,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Name="Nav2" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" Data="M8,1.3 L14,3.8 V8 C14,11.5 11.4,14.1 8,15 C4.6,14.1 2,11.5 2,8 V3.8 Z M5.6,7.8 L7.4,9.7 L10.6,5.9" />
                <TextBlock Text="挂机等房" Margin="11,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Name="Nav3" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" Data="M4.3,7 A3.7,3.7 0 0 1 11.7,7 V11 L13,13.2 H3 L4.3,11 Z M6.4,14.7 A1.7,1.7 0 0 0 9.6,14.7" />
                <TextBlock Text="开局警报" Margin="11,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Name="Nav5" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" Data="M2.5,2.2 V13.5 H13.8 M5.6,13.5 V9.2 M8.6,13.5 V5.4 M11.6,13.5 V7.8" />
                <TextBlock Text="对战数据" Margin="11,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Name="Nav4" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" Data="M8,1.6 A6.4,6.4 0 1 0 8,14.4 A6.4,6.4 0 1 0 8,1.6 Z M8,7.3 V11.5 M8,4.4 V5.1" />
                <TextBlock Text="日志与关于" Margin="11,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
          <Border Grid.Row="2" CornerRadius="11" Background="#0AFFFFFF" BorderBrush="{StaticResource B.Line}" BorderThickness="1" Padding="11,9" Margin="14,0,14,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse Name="SideDot" Width="7" Height="7" Fill="{StaticResource B.Dim}" VerticalAlignment="Center" />
                <TextBlock Name="SideKeep" Text="挂机等房未启动" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Name="SideRoom" Text="房间接口：连接中…" Style="{StaticResource Caption}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
      <ScrollViewer Name="P1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,24,26,32">
          <TextBlock Text="房间悬浮窗" Style="{StaticResource PageTitle}" />
          <TextBlock Text="置顶小窗实时显示房间里 10 个位置的玩家；位置、透明度和显示内容都能自己调。" Style="{StaticResource PageSub}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="悬浮窗显示" Style="{StaticResource CardHead}" />
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="显示悬浮窗（置顶显示房间里 10 个位置）" Style="{StaticResource Body}" />
                <ToggleButton Name="SwOverlay" Grid.Column="1" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="鼠标穿透" Style="{StaticResource Body}" />
                  <TextBlock Text="开启后鼠标直接穿过去，不会挡住你点别的东西（右键悬浮窗也能临时切）" Style="{StaticResource Muted}" />
                </StackPanel>
                <ToggleButton Name="SwClickThrough" Grid.Column="1" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="显示玩家昵称（关闭则显示档案尾号）" Style="{StaticResource Body}" />
                <ToggleButton Name="SwNick" Grid.Column="1" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="只显示有人的位置" Style="{StaticResource Body}" />
                <ToggleButton Name="SwOnlyFilled" Grid.Column="1" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="不透明度" Style="{StaticResource Body}" />
                <Slider Name="SldOpacity" Grid.Column="1" Style="{StaticResource Sld}" Minimum="0.3" Maximum="1" Value="0.94" ValueChanged="SldOpacity_ValueChanged" />
                <TextBlock Name="TxtOpacity" Grid.Column="2" Text="94%" Style="{StaticResource Body}" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="操作" Style="{StaticResource CardHead}" />
              <StackPanel Orientation="Horizontal">
                <Button Name="BtnShowOverlay" Content="显示悬浮窗" Style="{StaticResource BtnPrimary}" Click="BtnShowOverlay_Click" />
                <Button Content="重置悬浮窗位置" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnResetPos_Click" />
                <Button Content="打开设置文件所在目录" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnOpenDir_Click" />
              </StackPanel>
              <TextBlock Text="拖动悬浮窗的标题栏可以移动，位置会自动记住。" Style="{StaticResource Muted}" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Name="P2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="26,24,26,32">
          <TextBlock Text="挂机等房" Style="{StaticResource PageTitle}" />
          <TextBlock Text="挂机时定期往游戏窗口送一次键鼠输入，躲开「长时间无操作被移出房间」。" Style="{StaticResource PageSub}" />
          <Border Style="{StaticResource Card}" Background="{StaticResource B.WarnSoft}" BorderBrush="{StaticResource B.Warn}" BorderThickness="1" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="⚠ 请确认自己真的有充足的时间再考虑开启此功能！" Foreground="{StaticResource B.Warn}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
              <TextBlock Text="开启后会持续往游戏窗口发送键鼠输入。挂机等房本身违反暴雪 EULA 的精神，也可能让你在不知情的情况下被留在房间里占位 —— 请自行判断风险，并确保你确实有时间打完这一局。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="等房设置" Style="{StaticResource CardHead}" />
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="启用挂机等房" Style="{StaticResource Body}" />
                <ToggleButton Name="SwKeep" Grid.Column="1" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
              <TextBlock Text="等房方式" Style="{StaticResource Body}" Margin="0,12,0,6" />
              <StackPanel Orientation="Horizontal">
                <RadioButton Name="RbHidden" Style="{StaticResource Seg}" GroupName="keep" Content="静默（仅在游戏内生效）" Checked="Any_Changed" />
                <RadioButton Name="RbFocus" Style="{StaticResource Seg}" GroupName="keep" Content="切换程序（会闪烁黑屏）" Margin="8,0,0,0" Checked="Any_Changed" />
                <RadioButton Name="RbBoth" Style="{StaticResource Seg}" GroupName="keep" Content="两者都用（推荐额外设置）" Margin="8,0,0,0" Checked="Any_Changed" />
              </StackPanel>
              <TextBlock Text="· 静默：只在游戏窗口里生效 —— 游戏本来就在前台时走真实输入（能自检），游戏在后台时只能投递消息、无法确认是否记账。&#xA;· 切换程序：把游戏切到前台再切回去，会把你的鼠标键鼠接管一下，屏幕上会闪一下黑屏，但最稳、百分百有效。&#xA;· 两者都用（推荐）：平时用静默，超过下面的「切换程序兜底间隔」还没确认成功就切一次程序。推荐额外把「切换程序兜底间隔」设成 90 秒。" Style="{StaticResource Muted}" Margin="0,8,0,0" />
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="脉冲间隔（秒）— 每这么久等房一次，必须小于游戏的 5 分钟判定" Style="{StaticResource Body}" />
                <TextBox Name="TbInterval" Grid.Column="1" Style="{StaticResource Tb}" LostFocus="Num_LostFocus" KeyDown="Num_KeyDown" />
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="切换程序兜底间隔（秒）— 只有「两者都用」时生效" Style="{StaticResource Body}" />
                <TextBox Name="TbFocusEvery" Grid.Column="1" Style="{StaticResource Tb}" LostFocus="Num_LostFocus" KeyDown="Num_KeyDown" />
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="我正在打字时先别抢焦点（最多推迟 8 秒）" Style="{StaticResource Body}" />
                  <TextBlock Text="防止你的按键被游戏吞掉；推到最后仍会继续，不会因此被踢。" Style="{StaticResource Muted}" />
                </StackPanel>
                <ToggleButton Name="SwNoInterrupt" Grid.Column="1" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="侦测到对局开始就自动停止" Style="{StaticResource Body}" />
                  <TextBlock Text="房间列表里没有你了（已经开局 / 回主菜单 / 房间散了）就暂停脉冲 —— 对局里没有挂机踢出，不必打扰你。默认开。" Style="{StaticResource Muted}" />
                </StackPanel>
                <ToggleButton Name="SwPauseInMatch" Grid.Column="1" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="状态" Style="{StaticResource CardHead}" />
              <TextBlock Name="TxtKeepStatus" Text="挂机等房：未启动" Style="{StaticResource Body}" TextWrapping="Wrap" />
              <TextBlock Name="TxtKeepNote" Text="" Style="{StaticResource Muted}" Foreground="{StaticResource B.Warn}" Margin="0,6,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="立即脉冲一次" Style="{StaticResource BtnPrimary}" Click="BtnPulseNow_Click" />
                <Button Content="启动" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnKeepStart_Click" />
                <Button Content="停止" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnKeepStop_Click" />
                <Button Content="试响警报" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnTestAlert_Click" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Name="P3" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="26,24,26,32">
          <TextBlock Text="开局警报" Style="{StaticResource PageTitle}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="启用警报" Style="{StaticResource Body}" />
                <ToggleButton Name="SwAlert" Grid.Column="1" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="① 房间满人时警报" Style="{StaticResource Body}" />
                </StackPanel>
                <TextBox Name="TbSlots" Grid.Column="1" Style="{StaticResource Tb}" Margin="0,0,10,0" LostFocus="Num_LostFocus" KeyDown="Num_KeyDown" />
                <ToggleButton Name="SwOnFull" Grid.Column="2" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="② 确认开局时警报" Style="{StaticResource Body}" />
                </StackPanel>
                <ToggleButton Name="SwOnStart" Grid.Column="1" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="声音（满人和开局用两种不同的声音）" Style="{StaticResource CardHead}" />
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="启用声音" Style="{StaticResource Body}" />
                <ToggleButton Name="SwSound" Grid.Column="1" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
              <TextBlock Text="房间满人" Style="{StaticResource Body}" Margin="0,12,0,2" />
              <StackPanel Orientation="Horizontal">
                <Button Content="选择声音…（wav/mp3）" Style="{StaticResource Btn}" Click="BtnPickSoundFull_Click" />
                <Button Content="清除" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnClearSoundFull_Click" />
                <Button Content="试听" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnTestSoundFull_Click" />
                <TextBlock Name="TxtSoundFull" Text="（未选择，用内置「短促双响」）" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="确认开局" Style="{StaticResource Body}" Margin="0,12,0,2" />
              <StackPanel Orientation="Horizontal">
                <Button Content="选择声音…（wav/mp3）" Style="{StaticResource Btn}" Click="BtnPickSoundStart_Click" />
                <Button Content="清除" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnClearSoundStart_Click" />
                <Button Content="试听" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnTestSoundStart_Click" />
                <TextBlock Name="TxtSoundStart" Text="（未选择，用内置「上扬三响」）" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="警报画面（默认只出声音 + 角落小提示）" Style="{StaticResource CardHead}" />
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="显示图片（铺满屏幕的大横幅）" Style="{StaticResource Body}" />
                <ToggleButton Name="SwImg" Grid.Column="1" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="选择图片…（png/jpg/gif/bmp）" Style="{StaticResource Btn}" Click="BtnPickImg_Click" />
                <Button Content="清除图片" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnClearImg_Click" />
                <TextBlock Name="TxtImgPath" Text="（未选择，用文字横幅）" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <Border Margin="0,12,0,0" CornerRadius="10" Background="#FF11161D" BorderBrush="{StaticResource B.Line}" BorderThickness="1" Padding="10">
                <Image Name="ImgPreview" Stretch="Uniform" MaxHeight="120" HorizontalAlignment="Left" />
              </Border>
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="① 满人横幅文字（留空 = 不出横幅）" Style="{StaticResource Body}" />
                <TextBox Name="TbTextFull" Grid.Column="1" Style="{StaticResource Tb}" TextChanged="TbText_TextChanged" />
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="② 开局横幅文字（留空 = 不出横幅）" Style="{StaticResource Body}" />
                <TextBox Name="TbTextStart" Grid.Column="1" Style="{StaticResource Tb}" TextChanged="TbText_TextChanged" />
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="自动隐藏（秒，0 = 一直显示直到你点掉）" Style="{StaticResource Body}" />
                <TextBox Name="TbAutoHide" Grid.Column="1" Style="{StaticResource Tb}" LostFocus="Num_LostFocus" KeyDown="Num_KeyDown" />
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="试响一次（看看图和声音）" Style="{StaticResource BtnPrimary}" Click="BtnTestAlert_Click" />
                
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="进人提示" Style="{StaticResource CardHead}" />
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="房间里进人时，角落轻提示一下" Style="{StaticResource Body}" />
                  
                </StackPanel>
                <ToggleButton Name="SwJoin" Grid.Column="1" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="提示文字（可以自己改）" Style="{StaticResource Body}" />
                  
                </StackPanel>
                <TextBox Name="TbJoinText" Grid.Column="1" Style="{StaticResource Tb}" TextChanged="TbJoin_TextChanged" />
              </Grid>
              <TextBlock Text="显示位置（默认右上角）" Style="{StaticResource Body}" Margin="0,12,0,6" />
              <StackPanel Orientation="Horizontal">
                <RadioButton Name="RbCornerRT" Style="{StaticResource Seg}" GroupName="corner" Content="右上" Checked="Any_Changed" />
                <RadioButton Name="RbCornerRB" Style="{StaticResource Seg}" GroupName="corner" Content="右下" Margin="8,0,0,0" Checked="Any_Changed" />
                <RadioButton Name="RbCornerLT" Style="{StaticResource Seg}" GroupName="corner" Content="左上" Margin="8,0,0,0" Checked="Any_Changed" />
                <RadioButton Name="RbCornerLB" Style="{StaticResource Seg}" GroupName="corner" Content="左下" Margin="8,0,0,0" Checked="Any_Changed" />
              </StackPanel>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="停留几秒" Style="{StaticResource Body}" />
                <TextBox Name="TbToastSec" Grid.Column="1" Style="{StaticResource Tb}" LostFocus="Num_LostFocus" KeyDown="Num_KeyDown" />
              </Grid>
              <Button Content="试一下这个提示" Style="{StaticResource Btn}" Margin="0,14,0,0" HorizontalAlignment="Left" Click="BtnTestToast_Click" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Name="P5" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="26,24,26,32">
          <TextBlock Text="对战数据" Style="{StaticResource PageTitle}" />
          <TextBlock Text="从东方月灵传站点读取战绩、常用英雄和天梯排位。" Style="{StaticResource PageSub}" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton Name="RbOnline" Style="{StaticResource Seg}" GroupName="p5mode" Content="在线对局" IsChecked="True" Checked="P5Mode_Changed" />
            <RadioButton Name="RbLocal" Style="{StaticResource Seg}" GroupName="p5mode" Content="本地对局" Margin="8,0,0,0" Checked="P5Mode_Changed" />
          </StackPanel>
          <Border Name="P5Me" Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="88" Height="88" CornerRadius="12" Background="{StaticResource B.Card2}" ClipToBounds="True" VerticalAlignment="Top">
                <Image Name="MeImg" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,10,0">
                <TextBlock Name="MeName" Text="（还没读到数据）" Style="{StaticResource H1}" />
                <TextBlock Name="MeHandle" Text="" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                <TextBlock Name="MeStats" Text="" Style="{StaticResource Body}" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock Name="MeBest" Text="" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <Button Content="刷新数据" Style="{StaticResource BtnPrimary}" Click="BtnRefreshTouhou_Click" />
                <Button Content="英雄名表（可改）" Style="{StaticResource Btn}" Margin="0,6,0,0" ToolTip="站点只有英文英雄名，这里打开一个中文名对照表（data\heroes.tsv），照游戏里的写法改完保存、再点「刷新数据」即可。" Click="BtnHeroNames_Click" />
                <TextBlock Name="TxtTouhouState" Text="" Style="{StaticResource Muted}" Margin="0,8,0,0" MaxWidth="170" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Name="P5Bank" Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="本地存档战绩" Style="{StaticResource CardHead}" />
                  <TextBlock Text="直接读本机星际争霸 II 里的 touhou.SC2Bank（游戏自己写的存档）。完全离线，不联网、也不依赖 touhou_client。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                  <ComboBox Name="CbBank" Width="176" VerticalAlignment="Center" SelectionChanged="CbBank_SelectionChanged" ToolTip="本机所有账号/档案的存档；默认选中当前账号" />
                  <Button Content="读取本地存档" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Click="BtnBankLoad_Click" />
                </StackPanel>
              </Grid>
              <TextBlock Name="BankStats" Text="还没读取。" Style="{StaticResource Body}" Margin="0,12,0,0" TextWrapping="Wrap" />
              <TextBlock Name="BankBest" Text="" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
              <TextBlock Name="BankWhere" Text="" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Name="P5Matches" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="最近对局" Style="{StaticResource CardHead}" />
              <TextBlock Name="MatchesSub" Text="" Style="{StaticResource Muted}" TextWrapping="Wrap" />
              <ItemsControl Name="ListMatches">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="6,4" Margin="0,0,0,2" CornerRadius="8" Background="#00FFFFFF" Cursor="Hand" ToolTip="点开看这一局的详细数据" MouseLeftButtonUp="MatchRow_Click">
                      <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="34" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="7" Background="{StaticResource B.Card2}" ClipToBounds="True">
                          <Image Stretch="UniformToFill" Source="{Binding Img}" />
                        </Border>
                        <TextBlock Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Result}" Foreground="{Binding ResultBrush}" />
                        <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                          <TextBlock Style="{StaticResource Body}" Text="{Binding Title}" />
                          <TextBlock Style="{StaticResource Muted}" Text="{Binding Sub}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="{Binding Right}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Name="P5Heroes" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="我的英雄" Style="{StaticResource CardHead}" />
              <TextBlock Name="HeroesSub" Text="" Style="{StaticResource Muted}" TextWrapping="Wrap" />
              <ItemsControl Name="ListHeroes">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="210" Margin="0,0,10,10" Padding="8" CornerRadius="10" Background="{StaticResource B.Card2}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{StaticResource B.Card}" ClipToBounds="True">
                          <Image Stretch="UniformToFill" Source="{Binding Img}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                          <TextBlock Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                          <TextBlock Style="{StaticResource Muted}" Text="{Binding Sub}" />
                          <TextBlock Style="{StaticResource Muted}" Text="{Binding Right}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Name="P5BankHeroes" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="英雄战绩 · 本地存档" Style="{StaticResource CardHead}" />
              <TextBlock Name="BankHeroSub" Text="数据来自 touhou.SC2Bank 的 dbHeroNN 段，按场次排序。" Style="{StaticResource Muted}" TextWrapping="Wrap" />
              <ItemsControl Name="ListBankHeroes" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="210" Margin="0,0,10,10" Padding="8" CornerRadius="10" Background="{StaticResource B.Card2}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{StaticResource B.Card}" ClipToBounds="True">
                          <Image Stretch="UniformToFill" Source="{Binding Img}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                          <TextBlock Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                          <TextBlock Style="{StaticResource Muted}" Text="{Binding Sub}" />
                          <TextBlock Style="{StaticResource Muted}" Text="{Binding Right}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Name="P5BankConfigs" Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <TextBlock Text="英雄加点 · 本地存档" Style="{StaticResource CardHead}" />
                <Button Name="BtnPresetEdit" Content="编辑加点方案…" HorizontalAlignment="Right" Padding="10,2" Click="BtnPresetEdit_Click" />
              </Grid>
              <TextBlock Name="BankCfgSub" Text="数据来自 touhou.SC2Bank 的 dbHeroNN_config 段，是游戏自己写的加点方案（明文，每项一个数字）。" Style="{StaticResource Muted}" TextWrapping="Wrap" />
              <ItemsControl Name="ListBankConfigs" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="6,5" Margin="0,0,0,4" CornerRadius="8" Background="{StaticResource B.Card2}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="36" />
                          <ColumnDefinition Width="150" />
                          <ColumnDefinition Width="230" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" VerticalAlignment="Center" Background="{StaticResource B.Card}" ClipToBounds="True">
                          <Image Source="{Binding Img}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Sub}" />
                        <ItemsControl Grid.Column="3" VerticalAlignment="Center" ItemsSource="{Binding Cells}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Width="30" Margin="0,0,2,0" ToolTip="{Binding Tip}">
                                <Border Width="22" Height="22" CornerRadius="4" HorizontalAlignment="Center" Background="#2AFFFFFF">
                                  <Image Source="{Binding Icon}" Stretch="Uniform" Opacity="{Binding Alpha}" />
                                </Border>
                                <TextBlock Text="{Binding Num}" FontSize="10" HorizontalAlignment="Center" Opacity="0.85" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Name="P5Rank" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="天梯排位" Style="{StaticResource CardHead}" />
              <ItemsControl Name="ListRank">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="6,4" Margin="0,0,0,3" CornerRadius="8" Background="{Binding RowBrush}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="34" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Body}" VerticalAlignment="Center" Text="{Binding No}" />
                        <Border Grid.Column="1" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center" ClipToBounds="True">
                          <Image Stretch="UniformToFill" Source="{Binding Region}" />
                        </Border>
                        <Border Grid.Column="2" Width="26" Height="26" CornerRadius="6" Margin="7,0,0,0" Background="{StaticResource B.Card}" VerticalAlignment="Center" ClipToBounds="True">
                          <Image Stretch="UniformToFill" Source="{Binding Img}" />
                        </Border>
                        <TextBlock Grid.Column="3" Style="{StaticResource Body}" Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="{Binding Right}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Name="P4" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="26,24,26,32">
          <TextBlock Text="日志与关于" Style="{StaticResource PageTitle}" />
          <TextBlock Text="运行日志、托盘行为与版本说明。" Style="{StaticResource PageSub}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="运行日志" Style="{StaticResource CardHead}" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="刷新日志" Style="{StaticResource Btn}" Click="BtnRefreshLog_Click" />
                <Button Content="打开日志文件所在目录" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnOpenDir_Click" />
                <Button Content="清空显示" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnClearLogView_Click" />
              </StackPanel>
              <TextBox Name="TbLog" Style="{StaticResource Tb}" Height="330" IsReadOnly="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="NoWrap" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="窗口与托盘" Style="{StaticResource CardHead}" />
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="关闭窗口时隐藏到托盘（不退出程序）" Style="{StaticResource Body}" />
                  <TextBlock Text="开启：点右上角的 ✕ 只是把面板收起来，挂机等房和警报继续跑，右下角托盘图标里可以再打开或退出。关闭：点 ✕ 直接退出程序（挂机等房也会停）。" Style="{StaticResource Muted}" />
                </StackPanel>
                <ToggleButton Name="SwCloseToTray" Grid.Column="1" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="关闭时角落里提示一句「程序还在托盘里跑」" Style="{StaticResource Body}" />
                  <TextBlock Text="免得你以为程序已经关了、其实挂机等房还在跑（或者反过来）。" Style="{StaticResource Muted}" />
                </StackPanel>
                <ToggleButton Name="SwTrayHint" Grid.Column="1" Style="{StaticResource Switch}" Checked="Any_Changed" Unchecked="Any_Changed" />
              </Grid>
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="托盘图标不见了？（资源管理器重启、或它在溢出区里）" Style="{StaticResource Body}" />
                  <TextBlock Text="点一下重新挂上图标；正常运行时它也会在资源管理器重启后自动补回来。图标可能被收在托盘的小三角「溢出区」里，拖出来就会一直显示。" Style="{StaticResource Muted}" />
                </StackPanel>
                <Button Grid.Column="1" Content="重新显示托盘图标" Style="{StaticResource Btn}" VerticalAlignment="Center" Click="BtnReTray_Click" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="关于" Style="{StaticResource CardHead}" />
              <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="SC-touhoubox v1.1 · 面向《星际争霸II》国服（网易/战网）公开房间的挂机保护 + 开局提醒 + 东方月灵传数据面板。" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" Text="· 挂机判定：暴雪服务端在房间内要求「有键鼠输入送进游戏窗口」，约 5 分钟没有任何输入就断开连接。窗口可见但没焦点不算，最小化也不算。无预警、无开关、房主也关不掉。" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" Text="· 房间列表：读本机 touhou_client.exe 在 127.0.0.1:8030 提供的 /lobbyPlayerList（POST，返回冒号分隔的 10 个槽位）。只读，不发任何指令。" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" Text="· 提醒：第三方自动化在暴雪 EULA 上有争议。本工具只做「鼠标净位移 0 的 1 像素抖动」和只读查询，不做游戏内操作，但请自行判断风险。" />
              <TextBlock Name="TxtAboutPaths" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>