<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Sc2Toolbox.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SC-touhoubox · 东方月灵传助手" Height="720" Width="1040" MinHeight="600" MinWidth="900" Background="{StaticResource B.Window}" Foreground="{StaticResource B.Text}" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" WindowStyle="None" ResizeMode="CanResize" Icon="/app.ico" xmlns:local="clr-namespace:Sc2Toolbox" PreviewKeyDown="Window_PreviewKeyDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- 卡片标题：点一下折叠 / 展开这张卡片。放在窗口资源里才能挂事件处理函数。 -->
    <Style x:Key="CardHead" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource H2}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="ToolTip" Value="点一下折叠 / 展开这张卡片" />
      <EventSetter Event="MouseLeftButtonDown" Handler="CardHead_Click" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 英雄卡：在线战绩和本地存档共用同一套模板 -->
    <DataTemplate x:Key="HeroTile">
      <Border Margin="0,0,10,10" Padding="9" CornerRadius="10" Background="{StaticResource B.Card2}" BorderBrush="#0FFFFFFF" BorderThickness="1" HorizontalAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{StaticResource B.Card}" ClipToBounds="True">
            <Image Stretch="UniformToFill" Source="{Binding Img}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" Text="{Binding Sub}" />
            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Text="{Binding Right}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== 自绘标题栏 ===== -->
    <Grid Grid.Row="0" Background="#0AFFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <FrameworkElement.ContextMenu>
        <ContextMenu>
          <MenuItem Header="最小化" Click="BtnMin_Click" />
          <MenuItem Header="最大化 / 还原" Click="BtnMax_Click" />
          <Separator />
          <MenuItem Header="关闭" Click="BtnClose_Click" />
        </ContextMenu>
      </FrameworkElement.ContextMenu>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
        <Border Width="5" Height="5" CornerRadius="3" Background="{StaticResource B.Accent}" VerticalAlignment="Center" />
        <TextBlock Name="TxtBarTitle" Text="房间悬浮窗" Foreground="{StaticResource B.Muted}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1" Background="{StaticResource B.LineSoft}" IsHitTestVisible="False" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,5,0" VerticalAlignment="Center">
        <Button Name="BtnMin" Style="{StaticResource WinBtn}" Click="BtnMin_Click" ToolTip="最小化" AutomationProperties.Name="最小化">
          <Rectangle Width="11" Height="1.4" RadiusX="0.7" RadiusY="0.7" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
        </Button>
        <Button Name="BtnMax" Style="{StaticResource WinBtn}" Click="BtnMax_Click" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原">
          <Grid>
            <Path Name="GlyphMax" Data="M0.6,0.6 H10.6 V10.6 H0.6 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.1" />
            <Path Name="GlyphRestore" Data="M3.6,0.6 H10.6 V7.6 M0.6,3.6 H7.6 V10.6 H0.6 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.1" Visibility="Collapsed" />
          </Grid>
        </Button>
        <Button Name="BtnClose" Style="{StaticResource WinBtnClose}" Click="BtnClose_Click" ToolTip="关闭" AutomationProperties.Name="关闭">
          <Path Data="M0.6,0.6 L10.6,10.6 M10.6,0.6 L0.6,10.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.1" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ===== 主体 ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource B.Sidebar}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,18,18,16">
            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource B.Card2}" BorderBrush="{StaticResource B.LineSoft}" BorderThickness="1" ClipToBounds="True">
              <Image Source="/brand.png" Stretch="Uniform" Margin="1" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="SC-touhoubox" Foreground="{StaticResource B.Text}" FontSize="15" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock Text="东方月灵传助手" Foreground="{StaticResource B.Dim}" FontSize="10.5" VerticalAlignment="Center" />
                <Border Background="{StaticResource B.AccentSoft}" CornerRadius="99" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="v1.3" Foreground="{StaticResource B.Accent2}" FontSize="9.5" />
                </Border>
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="10,0">
            <TextBlock Text="游戏内" Style="{StaticResource NavCap}" />
            <RadioButton Name="Nav1" Style="{StaticResource Nav}" GroupName="nav" IsChecked="True" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" Data="M1.5,2.5 H14.5 V11.5 H1.5 Z M6,14.5 H10 M8,11.5 V14.5" />
                <TextBlock Text="房间悬浮窗" Margin="11,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Name="Nav2" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" Data="M8,1.3 L14,3.8 V8 C14,11.5 11.4,14.1 8,15 C4.6,14.1 2,11.5 2,8 V3.8 Z M5.6,7.8 L7.4,9.7 L10.6,5.9" />
                <TextBlock Text="挂机等房" Margin="11,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Name="Nav3" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" Data="M4.3,7 A3.7,3.7 0 0 1 11.7,7 V11 L13,13.2 H3 L4.3,11 Z M6.4,14.7 A1.7,1.7 0 0 0 9.6,14.7" />
                <TextBlock Text="开局警报" Margin="11,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Name="Nav6" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" Data="M9.6,1.5 L4.1,8.9 H7.7 L6.2,14.5 L11.9,7 H8.3 Z" />
                <TextBlock Text="快捷施法" Margin="11,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <TextBlock Text="数据" Style="{StaticResource NavCap}" />
            <RadioButton Name="Nav5" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" Data="M2.5,2.2 V13.5 H13.8 M5.6,13.5 V9.2 M8.6,13.5 V5.4 M11.6,13.5 V7.8" />
                <TextBlock Text="对战数据" Margin="11,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <TextBlock Text="其它" Style="{StaticResource NavCap}" />
            <RadioButton Name="Nav4" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" Data="M8,1.6 A6.4,6.4 0 1 0 8,14.4 A6.4,6.4 0 1 0 8,1.6 Z M8,7.3 V11.5 M8,4.4 V5.1" />
                <TextBlock Text="日志与关于" Margin="11,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
          <Border Grid.Row="2" CornerRadius="11" Background="#0AFFFFFF" BorderBrush="{StaticResource B.Line}" BorderThickness="1" Padding="12,10" Margin="14,0,14,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse Name="SideDot" Width="7" Height="7" Fill="{StaticResource B.Dim}" VerticalAlignment="Center" />
                <TextBlock Name="SideKeep" Text="挂机等房未启动" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Name="SideRoom" Text="房间接口：连接中…" Style="{StaticResource Caption}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Name="ClientBanner" Grid.Row="0" Background="#14F5B942" BorderBrush="#33F5B942" BorderThickness="0,0,0,1" Padding="30,10" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource B.WarnSoft}" VerticalAlignment="Center">
                <TextBlock Text="!" Foreground="{StaticResource B.Warn}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Name="TxtClientBannerTitle" Text="未检测到 touhou_client（房间接口）" Foreground="{StaticResource B.Text}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Name="TxtClientBannerSub" Text="安装内置版本后，仅在本程序运行时启动，退出时自动关闭。" Foreground="{StaticResource B.Muted}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
              <Button Name="BtnBannerClient" Content="安装并启动" Style="{StaticResource BtnPrimary}" Click="BtnClientInstall_Click" />
              <Button Name="BtnBannerLater" Content="稍后" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Click="BtnClientLater_Click" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
      <ScrollViewer Name="P1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,36" MaxWidth="880" HorizontalAlignment="Stretch">
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="房间悬浮窗" Style="{StaticResource PageTitle}" />
            </StackPanel>
          </Grid>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="悬浮窗显示" Style="{StaticResource CardHead}" />
              <local:SettingRow x:Name="SwOverlay" Header="显示悬浮窗" Checked="Any_Changed" Unchecked="Any_Changed" />
              <local:SettingRow x:Name="SwClickThrough" Header="鼠标穿透" Checked="Any_Changed" Unchecked="Any_Changed" />
              <local:SettingRow x:Name="SwNick" Header="显示玩家昵称" Checked="Any_Changed" Unchecked="Any_Changed" />
              <local:SettingRow x:Name="SwOnlyFilled" Header="只显示有人的位置" Checked="Any_Changed" Unchecked="Any_Changed" />
              <Border Style="{StaticResource Divider}" Margin="0,8" />
              <local:SettingField Header="不透明度">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Slider Name="SldOpacity" Style="{StaticResource Sld}" Width="230" Minimum="0.3" Maximum="1" Value="0.94" ValueChanged="SldOpacity_ValueChanged" />
                  <TextBlock Name="TxtOpacity" Text="94%" Style="{StaticResource Body}" Width="46" TextAlignment="Right" Margin="10,0,0,0" />
                </StackPanel>
              </local:SettingField>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="操作" Style="{StaticResource CardHead}" />
              <StackPanel Orientation="Horizontal">
                <Button Name="BtnShowOverlay" Content="显示悬浮窗" Style="{StaticResource BtnPrimary}" Click="BtnShowOverlay_Click" />
                <Button Content="重置悬浮窗位置" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnResetPos_Click" />
                <Button Content="打开设置文件所在目录" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnOpenDir_Click" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="直播弹幕" Style="{StaticResource CardHead}" />
              <local:SettingField Header="直播间号">
                <StackPanel Orientation="Horizontal">
                  <TextBox Name="TbDanmakuRoom" Style="{StaticResource Tb}" Width="180" LostFocus="DanmakuRoom_LostFocus" KeyDown="DanmakuRoom_KeyDown" />
                  <Button Name="BtnDanmakuApply" Content="连接" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnDanmakuApply_Click" />
                  <Button Content="断开" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnDanmakuStop_Click" />
                </StackPanel>
              </local:SettingField>
              <TextBlock Name="TxtDanmakuStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" Text="还没设置直播间。" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Name="P2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
        <StackPanel Margin="30,26,30,36" MaxWidth="880" HorizontalAlignment="Stretch">
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="挂机等房" Style="{StaticResource PageTitle}" />
            </StackPanel>
            <Border Name="KeepPill" Grid.Column="1" Style="{StaticResource Pill}" Background="#16F5B942" VerticalAlignment="Top" Margin="20,6,0,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Name="KeepPillDot" Width="6" Height="6" Fill="{StaticResource B.Warn}" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Name="TxtKeepPill" Text="未启动" Foreground="{StaticResource B.Warn}" FontSize="11.5" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
          <Border CornerRadius="12" Background="{StaticResource B.WarnSoft}" BorderBrush="#66F5B942" BorderThickness="1" Padding="14,12" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="28" Height="28" CornerRadius="14" Background="#26F5B942" VerticalAlignment="Top">
                <TextBlock Text="!" Foreground="{StaticResource B.Warn}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="请确认自己真的有充足的时间，再考虑开启此功能" Foreground="{StaticResource B.Warn}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="等房设置" Style="{StaticResource CardHead}" />
              <local:SettingRow x:Name="SwKeep" Header="启用挂机等房" Checked="Any_Changed" Unchecked="Any_Changed" />
              <Border Style="{StaticResource Divider}" Margin="0,8" />
              <local:SettingField Header="脉冲间隔（秒）">
                <TextBox Name="TbInterval" Style="{StaticResource TbNum}" LostFocus="Num_LostFocus" KeyDown="Num_KeyDown" />
              </local:SettingField>
              <local:SettingField Header="自动关闭（分钟，0 = 关）">
                <TextBox Name="TbAutoStop" Style="{StaticResource TbNum}" LostFocus="Num_LostFocus" KeyDown="Num_KeyDown" />
              </local:SettingField>
              <local:SettingRow x:Name="SwNoInterrupt" Header="我正在打字时先别抢焦点" Checked="Any_Changed" Unchecked="Any_Changed" />
              <local:SettingRow x:Name="SwPauseInMatch" Header="侦测到对局开始就自动停止" Note="以站点上「进行中的对局」为准（悬浮窗那块对局信息用的同一个数据源），房间列表里看不到自己也算；这样开局后不会再多送一次键鼠。" Checked="Any_Changed" Unchecked="Any_Changed" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="状态" Style="{StaticResource CardHead}" />
              <TextBlock Name="TxtKeepStatus" Text="挂机等房：未启动" Style="{StaticResource Body}" TextWrapping="Wrap" VerticalAlignment="Top" />
              <TextBlock Name="TxtKeepNote" Text="" Style="{StaticResource Muted}" Foreground="{StaticResource B.Warn}" Margin="0,6,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="立即脉冲一次" Style="{StaticResource BtnPrimary}" Click="BtnPulseNow_Click" />
                <Button Content="启动" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnKeepStart_Click" />
                <Button Content="停止" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnKeepStop_Click" />
                <Button Content="试响警报" Style="{StaticResource BtnGhost}" Margin="10,0,0,0" Click="BtnTestAlert_Click" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Name="P3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
        <StackPanel Margin="30,26,30,36" MaxWidth="880" HorizontalAlignment="Stretch">
          <Grid Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="开局警报" Style="{StaticResource PageTitle}" />
            </StackPanel>
          </Grid>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="警报开关" Style="{StaticResource CardHead}" />
              <local:SettingRow x:Name="SwAlert" Header="启用开局警报" Checked="Any_Changed" Unchecked="Any_Changed" />
              <Border Style="{StaticResource Divider}" Margin="0,8" />
              <local:SettingRow x:Name="SwOnFull" Header="房间满人时警报" Checked="Any_Changed" Unchecked="Any_Changed" />
              <local:SettingField Header="房间槽位数（2~10）">
                <TextBox Name="TbSlots" Style="{StaticResource TbNum}" Width="84" LostFocus="Num_LostFocus" KeyDown="Num_KeyDown" />
              </local:SettingField>
              <local:SettingRow x:Name="SwOnStart" Header="确认开局时警报" Checked="Any_Changed" Unchecked="Any_Changed" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="声音" Style="{StaticResource CardHead}" />
              <local:SettingRow x:Name="SwSound" Header="启用警报声音" Checked="Any_Changed" Unchecked="Any_Changed" />
              <Border Background="#08FFFFFF" CornerRadius="10" Padding="12" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="房间满人" Style="{StaticResource Body}" />
                    <TextBlock Name="TxtSoundFull" Text="（未选择，用内置「短促双响」）" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="选择…" Style="{StaticResource BtnGhost}" Click="BtnPickSoundFull_Click" />
                    <Button Content="清除" Style="{StaticResource BtnGhost}" Margin="6,0,0,0" Click="BtnClearSoundFull_Click" />
                    <Button Content="试听" Style="{StaticResource BtnGhost}" Margin="6,0,0,0" Click="BtnTestSoundFull_Click" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Background="#08FFFFFF" CornerRadius="10" Padding="12" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="确认开局" Style="{StaticResource Body}" />
                    <TextBlock Name="TxtSoundStart" Text="（未选择，用内置「上扬三响」）" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="选择…" Style="{StaticResource BtnGhost}" Click="BtnPickSoundStart_Click" />
                    <Button Content="清除" Style="{StaticResource BtnGhost}" Margin="6,0,0,0" Click="BtnClearSoundStart_Click" />
